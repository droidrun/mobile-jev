# Create a key at https://cloud.mobilerun.ai/api-keys
MOBILERUN_API_KEY=

# Run `pnpm devices` to find the ID of your own ready Android device.
MOBILERUN_DEVICE_ID=
MOBILERUN_BASE_URL=https://api.mobilerun.ai/v1
# Faster input acknowledgements, with exact local read-back before the next action.
# Set committed to retain the server-side completion wait for all text input.
MOBILERUN_TEXT_COMPLETION_MODE=accepted

# Create a TypeSafe key at https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# The studio binds to localhost only. Change this if the port is already in use.
STUDIO_PORT=3040
